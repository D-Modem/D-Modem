index 8f6abb7..3d9670b 100644
--- a/src/sa/sa.c
+++ b/src/sa/sa.c
@@ -21,6 +21,92 @@
 #include <re_dbg.h>
 
 
+#if defined(WIN32) && _WIN32_WINNT < 0x0600
+/* inet_pton() for Windows before Vista: IPv4's dotted quads (four
+   decimal numbers, no more and no less), IPv6 through Winsock 2's
+   WSAStringToAddressA() where the system has IPv6 */
+int re_inet_pton(int af, const char *src, void *dst)
+{
+	if (!src || !dst)
+		return -1;
+
+	if (af == AF_INET) {
+		uint8_t b[4];
+		int i;
+
+		for (i = 0; i < 4; i++) {
+			unsigned v = 0;
+			int n = 0;
+
+			while (*src >= '0' && *src <= '9' && n < 4) {
+				v = v * 10 + (unsigned)(*src++ - '0');
+				++n;
+			}
+			if (n == 0 || n > 3 || v > 255)
+				return 0;
+			b[i] = (uint8_t)v;
+			if (i < 3 && *src++ != '.')
+				return 0;
+		}
+		if (*src)
+			return 0;
+		memcpy(dst, b, 4);
+		return 1;
+	}
+#ifdef AF_INET6
+	if (af == AF_INET6) {
+		struct sockaddr_in6 sin6;
+		char buf[INET6_ADDRSTRLEN];
+		INT len = sizeof(sin6);
+
+		if (!strchr(src, ':') || strlen(src) >= sizeof(buf))
+			return 0;
+		str_ncpy(buf, src, sizeof(buf));
+		memset(&sin6, 0, sizeof(sin6));
+		if (WSAStringToAddressA(buf, AF_INET6, NULL,
+					(struct sockaddr *)&sin6, &len))
+			return 0;
+		memcpy(dst, &sin6.sin6_addr, sizeof(sin6.sin6_addr));
+		return 1;
+	}
+#endif
+	return -1;
+}
+
+
+/* inet_ntop() for Windows before Vista, as re_inet_pton() */
+const char *re_inet_ntop(int af, const void *src, char *dst, size_t size)
+{
+	if (!src || !dst)
+		return NULL;
+
+	if (af == AF_INET) {
+		const uint8_t *b = src;
+
+		if (re_snprintf(dst, size, "%u.%u.%u.%u",
+				b[0], b[1], b[2], b[3]) < 0)
+			return NULL;
+		return dst;
+	}
+#ifdef AF_INET6
+	if (af == AF_INET6) {
+		struct sockaddr_in6 sin6;
+		DWORD n = (DWORD)size;
+
+		memset(&sin6, 0, sizeof(sin6));
+		sin6.sin6_family = AF_INET6;
+		memcpy(&sin6.sin6_addr, src, sizeof(sin6.sin6_addr));
+		if (WSAAddressToStringA((struct sockaddr *)&sin6,
+					sizeof(sin6), NULL, dst, &n))
+			return NULL;
+		return dst;
+	}
+#endif
+	return NULL;
+}
+#endif
+
