// dmodemvm7.rc - the Windows 7 virtual modem driver's version resource

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "D-Modem"
			VALUE "FileDescription", "D-Modem virtual modem driver for Windows 7 and 8 (UMDF 1)"
			VALUE "FileVersion", "1.0.0.0"
			VALUE "InternalName", "dmodemvm7"
			VALUE "LegalCopyright", "Copyright (C) 2026 D-Modem Authors, AGPL-3.0-only"
			VALUE "OriginalFilename", "dmodemvm7.dll"
			VALUE "ProductName", "D-Modem"
			VALUE "ProductVersion", "1.0.0.0"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
