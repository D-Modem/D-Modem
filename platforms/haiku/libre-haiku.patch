# libre v4.12.0 on Haiku (cmake/libre.cmake applies it): the interface
# ioctls are in <sys/sockio.h> there, its struct ifreq has no ifr_ifru
# (ifr_addr, as on every system), and it has no routing table listing
# (net_rt_list(): libre's stub, as on iOS).
diff --git a/cmake/re-config.cmake b/cmake/re-config.cmake
index 8dea2f6..e8b7bb6 100644
--- a/cmake/re-config.cmake
+++ b/cmake/re-config.cmake
@@ -167,7 +167,7 @@ if(UNIX)
     HAVE_SIGNAL
     HAVE_FORK
     )
-  if(NOT IOS)
+  if(NOT IOS AND NOT ${CMAKE_SYSTEM_NAME} MATCHES "Haiku")
     list(APPEND RE_DEFINITIONS HAVE_ROUTE_LIST)
   endif()
 endif()
diff --git a/src/net/posix/pif.c b/src/net/posix/pif.c
index 53e2965..0d5f7b9 100644
--- a/src/net/posix/pif.c
+++ b/src/net/posix/pif.c
@@ -11,7 +11,7 @@
 #include <net/if.h>
 #include <arpa/inet.h>
 /*#include <net/if_arp.h>*/
-#ifdef __sun
+#if defined(__sun) || defined(__HAIKU__)
 #include <sys/sockio.h>
 #endif
 #include <re_types.h>
@@ -86,7 +86,7 @@ int net_if_list(net_ifaddr_h *ifh, void *arg)
 			continue;
 		}
 
-		err = sa_set_sa(&sa, &ifrr.ifr_ifru.ifru_addr);
+		err = sa_set_sa(&sa, &ifrr.ifr_addr);
 		if (err) {
 			DEBUG_WARNING("if_list: sa_set_sa %m\n", err);
 			break;
