;
; dmodem.conf - profiles of the DModem() application
;
;   exten => 5551000,1,DModem(bbs)
;   exten => 5552000,1,DModem(ppp)
;
; A profile:
;   mode = tcp       the data goes to a TCP server: host, port
;   mode = unix      the data goes to a server on a unix socket: path
;   mode = exec      the data goes to a program on a pty: command (run by
;                    /bin/sh -c, with DMODEM_CHANNEL, DMODEM_PROFILE,
;                    DMODEM_RATE, DMODEM_CALLERID, DMODEM_DIALED and
;                    DMODEM_CONNECTED (Unix time) in its environment);
;                    the pty is hung up when the call ends
;   header = no      tcp, unix: yes sends those variables to the server
;                    first, NAME=value lines and an empty line
;   init = AT...     extra AT commands for the modem, e.g. AT+MS=34 to
;                    stop at V.34, AT+MS=132 for V.32bis
;   answer = ATA     the command line the modem answers with; commands
;                    for the answering call alone go before the A, e.g.
;                    AT+MS=132\;A (a ; is written \; in this file).  A
;                    line that does not answer ends the call (ERROR)
;   law = auto       the G.711 law of the network, ulaw or alaw (auto:
;                    the channel's)
;   timeout = 60     seconds for the modems to connect
;
;   fax = yes        a fax machine calling (its CNG tone) is received
;                    as a fax (into fax_dir) instead of by the modem
;
; The server or program sees nothing until the modems are connected.
;
; Fax, here for all, or per profile:
;   fax_dir = /var/spool/asterisk/fax    where received faxes go
;   fax_ident = +1 555 0100              our number (CSI / TSI)
;   fax_max_rate = 14400                 9600, 7200, 4800, 2400 to go slower
;   fax_ecm = yes                        error correction mode offered
;   fax_t38 = yes                        over T.38 when the channel has it
;                                        (PJSIP with t38_udptl = yes)
; DModemSendFax(file[,ident]) and DModemReceiveFax(file[,ident]) use these
; of [general].

[general]
; the modem's log on the console (verbose 5): 0 errors only, 1 the modem
; core, 3 the data pumps too
debug = 0
; dmodem-ari (docs/ari.md) only: Asterisk's ARI and the Stasis() app's name
;ari_url = http://127.0.0.1:8088
;ari_user = dmodem
;ari_password = secret
;ari_app = dmodem
; dmodem-ari only, T.38: the calls on legs to its own SIP side, Asterisk's
; PJSIP endpoint sip_endpoint (with t38_udptl = yes) calling sip_bind
;t38 = yes
;sip_endpoint = dmodem
;sip_bind = 127.0.0.1:5090

[default]
mode = tcp
host = 127.0.0.1
port = 2323

; a BBS listening on a TCP port (raw, no telnet negotiation)
[bbs]
mode = tcp
host = 127.0.0.1
port = 2323

; PPP: pppd on the pty, with the line as its tty (pppd takes stdin when
; no device is given)
[ppp]
mode = exec
command = exec /usr/sbin/pppd nodetach noauth local lock passive 192.168.77.1:192.168.77.2 ms-dns 192.168.77.1

; a login and a menu (BBS, PPP, shell) for the caller: modemmenu,
; https://github.com/Neo-Desktop/modemmenu, a program for each call
;[menu]
;mode = exec
;command = exec /usr/local/bin/modemmenu -config /etc/asterisk/modemmenu.conf
; or one modemmenu -serve for every call
;[menu]
;mode = unix
;path = /run/modemmenu/modemmenu.sock
;header = yes

; a login program on the pty
;[login]
;mode = exec
;command = exec /bin/login
